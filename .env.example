# JWT
JWT_SECRET=your_random_64_char_secret_here

# MongoDB Atlas / Prisma
DATABASE_URL=mongodb+srv://username:password@cluster0.mongodb.net/gridwise?retryWrites=true&w=majority

# Optional direct URL for local tools
DIRECT_URL=mongodb+srv://username:password@cluster0.mongodb.net/gridwise?retryWrites=true&w=majority

# Google AI (for LangChain Gemini)
GOOGLE_AI_API_KEY=

# Microservice URLs
ML_SERVICE_URL=http://localhost:8001
RAG_SERVICE_URL=http://localhost:8002

# Python service optional paths (works with parent-level ml_service/rag_service)
# GRIDWISE_DATA_PATH=colab/karnataka_energy_2019_2024.csv
# GRIDWISE_TRAIN_DATA_PATH=colab/karnataka_energy_2019_2024.csv
# GRIDWISE_MODEL_DIR=ml_service/models
# VECTORSTORE_DIR=rag_service/vectorstore

# Seed admin defaults
ADMIN_EMAIL=admin@gridwise.in
ADMIN_NAME=GridWise Admin
ADMIN_PASSWORD=Admin@12345
ADMIN_DISTRICT=Bangalore Urban
ADMIN_CITY=Bengaluru
ADMIN_PINCODE=560001
